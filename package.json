{
  "name": "api_kadai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch app.ts",
    "watch": "bun --watch app.ts",
    "start": "bun app.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "bunx --env-file=.env --bun prisma generate --config ./prisma7.config.ts",
    "db:migrate": "bunx --env-file=.env --bun prisma migrate dev --config ./prisma7.config.ts",
    "db:deploy": "bunx --env-file=.env --bun prisma migrate deploy --config ./prisma7.config.ts",
    "test:smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "express": "5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
