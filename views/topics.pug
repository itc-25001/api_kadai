
extends layout

block main
  h2 トピック一覧

  button#logoutButton(type='button') ログアウト
  p#logoutResult

  ul#topicList
    li 読み込み中...

  div
    button#prevPage(type='button' disabled) 前のページ
    span#pageNumber 1ページ目
    button#nextPage(type='button' disabled) 次のページ

  p#pageResult

  h3 新しいトピックを作成

  form#createTopicForm
    div
      input#newTitle(
        type='text'
        placeholder='トピックのタイトル'
        maxlength='256'
        required
      )

    div
      textarea#newMessage(
        placeholder='最初のメッセージ'
        maxlength='512'
        required
      )

    button(type='submit') トピックを作成

  p#createTopicResult

  h3 名前・パスワード変更

  form#passwordForm
    input#newName(
      type='text'
      placeholder='新しい名前'
      maxlength='128'
    )

    input#newPassword(
      type='password'
      placeholder='新しいパスワード'
      minlength='8'
      maxlength='1024'
      autocomplete='new-password'
    )

    button(type='submit') 変更する

  p#passwordResult

  script.
    // 現在のページ番号
    let currentPage = 1;
    let hasNext = false;
    let loading = false;

    // トピック一覧を取得する
    async function loadTopics(page = currentPage) {
      if (loading) return;

      loading = true;

      const list = document.getElementById('topicList');
      const prevButton = document.getElementById('prevPage');
      const nextButton = document.getElementById('nextPage');
      const result = document.getElementById('pageResult');

      prevButton.disabled = true;
      nextButton.disabled = true;
      result.textContent = '';

      try {
        const response = await fetch('/api/topic?page=' + page);

        if (response.status === 401) {
          window.location.href = '/';
          return;
        }

        if (!response.ok) {
          result.textContent = 'トピックを取得できませんでした';
          return;
        }

        const data = await response.json();

        // 次のページにトピックがなければ移動しない
        if (data.topics.length === 0 && page > currentPage) {
          hasNext = false;
          result.textContent = 'これ以上トピックはありません';
          return;
        }

        currentPage = page;
        hasNext = data.topics.length === 5;

        list.replaceChildren();

        // 現在のページ番号を表示する
        document.getElementById('pageNumber').textContent =
          currentPage + 'ページ目';

        if (data.topics.length === 0) {
          const li = document.createElement('li');
          li.textContent = 'トピックはまだありません';
          list.appendChild(li);
          return;
        }

        // トピックを一覧に表示する
        data.topics.forEach(topic => {
          const li = document.createElement('li');

          const link = document.createElement('a');
          link.href = '/topics/' + encodeURIComponent(topic.id);
          link.textContent = topic.title;

          li.appendChild(link);

          li.appendChild(
            document.createTextNode(
              '（作成者：' + topic.author + '）'
            )
          );

          list.appendChild(li);
        });

      } catch (error) {
        result.textContent = '通信エラーが発生しました';
        console.error(error);

      } finally {
        loading = false;
        prevButton.disabled = currentPage === 1;
        nextButton.disabled = !hasNext;
      }
    }

    // 前のページへ移動
    document.getElementById('prevPage').addEventListener('click', async () => {
      if (currentPage > 1) {
        await loadTopics(currentPage - 1);
      }
    });

    // 次のページへ移動
    document.getElementById('nextPage').addEventListener('click', async () => {
      if (hasNext) {
        await loadTopics(currentPage + 1);
      }
    });

    // 名前・パスワード変更処理
    document.getElementById('passwordForm').addEventListener('submit', async (event) => {
      event.preventDefault();

      const nameInput = document.getElementById('newName');
      const passwordInput = document.getElementById('newPassword');
      const result = document.getElementById('passwordResult');

      const body = {};

      if (nameInput.value.trim() !== '') {
      body.name = nameInput.value.trim();
      }

      if (passwordInput.value !== '') {
      body.password = passwordInput.value;
      }

      if (Object.keys(body).length === 0) {
      result.textContent = '変更する項目を入力してください';
      return;
      }

      try {
      const response = await fetch('/api/user/change', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(body)
      });

      if (response.status === 401) {
      window.location.href = '/';
      return;
      }

      const data = await response.json();

      if (response.ok) {
      result.textContent = '変更しました';
      nameInput.value = '';
      passwordInput.value = '';
      await loadTopics();
      } else {
      result.textContent =
      data.errors?.[0]?.reason || '変更に失敗しました';
    }

    } catch (error) {
      result.textContent = '通信エラーが発生しました';
      console.error(error);
      }
    });

    // トピック新規作成処理
    document.getElementById('createTopicForm').addEventListener('submit', async (event) => {
      event.preventDefault();

      const title = document.getElementById('newTitle').value.trim();
      const message = document.getElementById('newMessage').value.trim();
      const result = document.getElementById('createTopicResult');

      try {
        const response = await fetch('/api/topic/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ title, message })
        });

        if (response.status === 401) {
          window.location.href = '/';
          return;
        }

        const data = await response.json();

        if (!response.ok) {
          result.textContent =
            data.errors?.[0]?.reason || '作成に失敗しました';
          return;
        }

        window.location.href =
          '/topics/' + encodeURIComponent(data.id);

      } catch (error) {
        result.textContent = '通信エラーが発生しました';
        console.error(error);
      }
    });

    // ログアウト処理
    document.getElementById('logoutButton').addEventListener('click', async () => {
      const result = document.getElementById('logoutResult');

      try {
        const response = await fetch('/api/user/logout', {
          method: 'POST'
        });

        if (response.ok || response.status === 401) {
          window.location.href = '/';
        } else {
          result.textContent = 'ログアウトに失敗しました';
        }

      } catch (error) {
        result.textContent = '通信エラーが発生しました';
        console.error(error);
      }
    });

    // 最初にトピック一覧を読み込む
    loadTopics();